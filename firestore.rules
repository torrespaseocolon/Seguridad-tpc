rules_version = '2';

// =============================================================================
// SEGURIDAD TPC — Reglas de seguridad de Cloud Firestore
// =============================================================================
// Estas reglas son la ÚNICA barrera real de permisos. La interfaz (botones
// ocultos, menús distintos por rol) es solo comodidad visual: un guardia con
// conocimientos técnicos que intente enviar una petición directa a Firestore
// (por ejemplo desde la consola del navegador) queda igualmente bloqueado
// aquí, porque el servidor de Firebase evalúa este archivo en cada lectura y
// escritura, sin excepción.
//
// Cada verificación de rol (isAdmin / isGuardActive) lee el documento
// users/{uid} del usuario que hace la solicitud. Esa lectura consume 1 cuota
// de "read" de Firestore — es un costo pequeño y esperado, ya explicado en
// docs/MODELO_DE_DATOS.md.
// =============================================================================

function isSignedIn() {
  return request.auth != null;
}

function profile() {
  return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
}

function isActiveUser() {
  return isSignedIn() && profile().active == true;
}

function isAdmin() {
  return isActiveUser() && profile().role == 'admin';
}

// Cualquier usuario activo (admin o guardia) puede operar el día a día.
function isStaff() {
  return isActiveUser() && (profile().role == 'admin' || profile().role == 'guard');
}

function unchangedExcept(allowedKeys) {
  return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
}

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // users — perfiles con rol y lobby
    // -------------------------------------------------------------------
    // El PRIMER administrador se crea manualmente desde la consola de
    // Firebase (ver manual, PASO 15) precisamente para no necesitar ninguna
    // excepción especial aquí que un guardia pudiera aprovechar para
    // auto-promoverse a administrador.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // nunca se borra un usuario, se desactiva (active:false)
    }

    // -------------------------------------------------------------------
    // settings — configuración global (solo lectura para staff, escritura admin)
    // -------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------
    // parking_spaces — estado en vivo de los 13 espacios
    // -------------------------------------------------------------------
    match /parking_spaces/{spaceId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow delete: if false;
      // El guardia SOLO puede tocar los campos operativos de ocupar/liberar.
      // El tipo de parqueo (visitante/discapacidad/deshabilitado) es
      // exclusivamente administrativo.
      allow update: if isAdmin() || (
        isStaff() &&
        unchangedExcept([
          'status', 'sessionId', 'visitorName', 'visitorId', 'plate',
          'destinationType', 'destinationNumber', 'entryAt',
          'entryGuardName', 'entryLobby', 'maxMinutesAtEntry', 'updatedAt'
        ])
      );
    }

    // -------------------------------------------------------------------
    // parking_sessions — historial permanente de entradas/salidas
    // -------------------------------------------------------------------
    match /parking_sessions/{sessionId} {
      allow read: if isStaff();
      allow delete: if false;

      allow create: if isStaff() &&
        request.resource.data.entryGuardUid == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.exitAt == null;

      // Cierre normal (salida) hecho por cualquier guardia/admin activo.
      // Corrección posterior (cualquier campo) reservada a administración.
      allow update: if isAdmin() || (
        isStaff() &&
        resource.data.status == 'open' &&
        request.resource.data.status == 'closed' &&
        request.resource.data.exitGuardUid == request.auth.uid &&
        unchangedExcept([
          'status', 'exitAt', 'exitGuardUid', 'exitGuardName',
          'exitLobby', 'durationMinutes'
        ])
      );
    }

    // -------------------------------------------------------------------
    // packages
    // -------------------------------------------------------------------
    match /packages/{id} {
      allow read: if isStaff();
      allow delete: if false;

      allow create: if isStaff() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isAdmin() || (
        isStaff() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'delivered' &&
        request.resource.data.deliveredByUid == request.auth.uid &&
        unchangedExcept(['status', 'deliveredAt', 'deliveredByUid', 'deliveredByName'])
      );
    }

    // -------------------------------------------------------------------
    // objects — catálogo administrado por admin; availableQuantity la
    // ajusta el guardia como efecto de un préstamo/devolución (+-1)
    // -------------------------------------------------------------------
    match /objects/{id} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow delete: if false;

      allow update: if isAdmin() || (
        isStaff() &&
        unchangedExcept(['availableQuantity']) &&
        (
          request.resource.data.availableQuantity == resource.data.availableQuantity - 1 ||
          request.resource.data.availableQuantity == resource.data.availableQuantity + 1
        )
      );
    }

    // -------------------------------------------------------------------
    // object_loans
    // -------------------------------------------------------------------
    match /object_loans/{id} {
      allow read: if isStaff();
      allow delete: if false;

      allow create: if isStaff() &&
        request.resource.data.loanedByUid == request.auth.uid &&
        request.resource.data.status == 'loaned';

      allow update: if isAdmin() || (
        isStaff() &&
        resource.data.status == 'loaned' &&
        request.resource.data.status == 'returned' &&
        request.resource.data.returnedByUid == request.auth.uid &&
        unchangedExcept([
          'status', 'returnedAt', 'returnedByUid', 'returnedByName',
          'returnObservations', 'returnCondition'
        ])
      );
    }

    // -------------------------------------------------------------------
    // access_items — tarjetas / stickers. El guardia SOLO marca "entregado".
    // -------------------------------------------------------------------
    match /access_items/{id} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow delete: if false;

      allow update: if isAdmin() || (
        isStaff() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'delivered' &&
        request.resource.data.deliveredByUid == request.auth.uid &&
        unchangedExcept(['status', 'deliveredAt', 'deliveredByUid', 'deliveredByName', 'deliveredLobby'])
      );
    }

    // -------------------------------------------------------------------
    // audit_logs — inmutable. Cada usuario solo puede crear un registro que
    // lo identifique a sí mismo; nadie puede editar ni borrar auditoría.
    // -------------------------------------------------------------------
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.userUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // error_reports — el guardia reporta y solo ve sus propios reportes;
    // solo administración puede resolverlos.
    // -------------------------------------------------------------------
    match /error_reports/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.reportedByUid == request.auth.uid);
      allow create: if isStaff() &&
        request.resource.data.reportedByUid == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Cualquier otra ruta no contemplada queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
