rules_version = '2';

// =============================================================================
// SEGURIDAD TPC — Reglas de seguridad de Cloud Firestore
// =============================================================================
// Estas reglas son la ÚNICA barrera real de permisos. La interfaz (botones
// ocultos, menús distintos por rol) es solo comodidad visual: un guardia con
// conocimientos técnicos que intente enviar una petición directa a Firestore
// (por ejemplo desde la consola del navegador) queda igualmente bloqueado
// aquí, porque el servidor de Firebase evalúa este archivo en cada lectura y
// escritura, sin excepción.
//
// Cada verificación de rol lee el documento users/{uid} del usuario que hace
// la solicitud (con get()). Esa lectura consume 1 cuota de "read" de
// Firestore — es un costo pequeño y esperado, ya explicado en
// docs/MODELO_DE_DATOS.md.
//
// IMPORTANTE — por qué get() está repetido en cada regla en vez de usar
// funciones tipo isAdmin()/isStaff(): en este proyecto se comprobó
// (13-ago-2026, ver historial) que get(/databases/$(database)/documents/...)
// funciona correctamente cuando se escribe DIRECTAMENTE dentro de la
// condición de un "allow", pero devuelve "Missing or insufficient
// permissions" cuando se llama desde dentro de una función (con o sin
// "let", con o sin anidar otra función) en esta base de datos. Es un
// comportamiento inusual, pero reproducido de forma consistente en pruebas
// controladas. Por eso el chequeo de rol se repite explícito en cada
// "allow" en vez de reutilizar una función — no lo simplifiques con
// funciones que llamen a get() sin volver a probarlo primero.
// =============================================================================

function isSignedIn() {
  return request.auth != null;
}

function unchangedExcept(allowedKeys) {
  return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
}

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // users — perfiles con rol y lobby
    // -------------------------------------------------------------------
    // El PRIMER administrador se crea manualmente desde la consola de
    // Firebase (ver manual, PASO 15) precisamente para no necesitar ninguna
    // excepción especial aquí que un guardia pudiera aprovechar para
    // auto-promoverse a administrador.
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Antes esto era "if false" (nunca se borra, solo se desactiva). Ahora
      // el admin también puede eliminar el perfil directamente — ver
      // deleteUser() en users.service.js para la nota sobre por qué esto NO
      // borra la cuenta de Firebase Authentication en sí.
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------
    // settings — configuración global (solo lectura para staff, escritura admin)
    // -------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard');
      allow write: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------
    // parking_spaces — estado en vivo de los 13 espacios
    // -------------------------------------------------------------------
    match /parking_spaces/{spaceId} {
      // viewer (solo lectura) puede leer para el Panel/Reportes de
      // Administración, pero no aparece en ningún "allow create/update" de
      // esta colección ni de ninguna otra — no puede operar nada.
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if false;
      // El guardia SOLO puede tocar los campos operativos de ocupar/liberar,
      // y solo si es el guardia de Lobby B (ago-2026: la entrada física real
      // de los parqueos de visita está únicamente ahí — el guardia de Lobby
      // A queda en modo consulta, ver canOperateParking() en parking.page.js).
      // El tipo de parqueo (visitante/discapacidad/deshabilitado) es
      // exclusivamente administrativo.
      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lobby == 'B' &&
         unchangedExcept([
           'status', 'sessionId', 'visitorName', 'visitorId', 'plate', 'visitorPhone', 'isDemo',
           'destinationType', 'destinationNumber', 'entryAt',
           'entryGuardName', 'entryLobby', 'maxMinutesAtEntry', 'updatedAt'
         ]))
      );
    }

    // -------------------------------------------------------------------
    // parking_sessions — historial permanente de entradas/salidas
    // -------------------------------------------------------------------
    match /parking_sessions/{sessionId} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      // Ago-2026 v2: a pedido explícito de administración, un admin ya puede
      // borrar CUALQUIER registro (antes solo los marcados isDemo:true —
      // "Limpiar demostración" los purgaba sin tocar la auditoría real,
      // que se mantenía intacta e inmutable a propósito). Ahora esa
      // garantía queda a criterio del administrador: puede reiniciar el
      // historial real también, por ejemplo desde Administración →
      // Desarrollador → "Reiniciar datos del sistema".
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Crear (entrada) y cerrar (salida) solo lo puede hacer el guardia de
      // Lobby B, o un administrador — misma restricción y misma razón que en
      // parking_spaces más arriba.
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lobby == 'B')) &&
        request.resource.data.entryGuardUid == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.exitAt == null;

      // Corrección posterior (cualquier campo) reservada a administración.
      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lobby == 'B' &&
         resource.data.status == 'open' &&
         request.resource.data.status == 'closed' &&
         request.resource.data.exitGuardUid == request.auth.uid &&
         // 'corrected'/'correctionNote' se agregaron acá (ago-2026) para que
         // registerVisitExit() (Visitantes) pueda cerrar un registro
         // "huérfano" —cuyo espacio ya fue liberado o reasignado a otro
         // vehículo mientras tanto— dejando una nota, sin necesitar admin.
         unchangedExcept(['status', 'exitAt', 'exitGuardUid', 'exitGuardName', 'exitLobby', 'durationMinutes', 'corrected', 'correctionNote']))
        ||
        // Corregir el NÚMERO de espacio de un registro que sigue abierto (el
        // vehículo se equivocó de parqueo y hay que mover la ocupación al
        // número correcto) — ver correctSessionSpace() en parking.service.js.
        // No cierra el registro, solo cambia a qué espacio pertenece.
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lobby == 'B' &&
         resource.data.status == 'open' &&
         request.resource.data.status == 'open' &&
         unchangedExcept(['spaceNumber', 'corrected', 'correctionNote']))
      );
    }

    // -------------------------------------------------------------------
    // visits — registro general de visitantes (ago-2026), separado de
    // parking_sessions: no toda visita necesita un espacio de parqueo.
    // Cuando sí lo necesita, el registro de parking_sessions se crea aparte
    // con las mismas reglas de arriba (Lobby B o admin) — acá solo se
    // guarda el enlace a ese registro.
    // -------------------------------------------------------------------
    match /visits/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
        request.resource.data.createdByUid == request.auth.uid;
      // El guardia de Lobby B (o admin) puede marcar la hora de salida del
      // condominio de una visita que registró él mismo, desde la pantalla
      // de Visitantes — mismo criterio de "solo Lobby B" que en
      // parking_spaces/parking_sessions más arriba. También puede corregir
      // CÓMO ingresó la visita (entryMode/plate/needsParking/
      // parkingSpaceNumber/parkingSessionId) — ej. se indicó "espacio de
      // propietario" pero terminó usando un parqueo de visita, o viceversa
      // (ver updateVisitEntry() en visits.service.js). Ningún otro campo
      // (nombre, cédula, destino...) se puede tocar desde acá.
      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lobby == 'B' &&
         unchangedExcept(['exitAt', 'entryMode', 'plate', 'needsParking', 'parkingSpaceNumber', 'parkingSessionId']))
      );
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------
    // packages
    // -------------------------------------------------------------------
    match /packages/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      // Ago-2026 v2: admin puede borrar cualquier paquete — ver nota igual en
      // parking_sessions más arriba.
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'delivered' &&
         request.resource.data.deliveredByUid == request.auth.uid &&
         unchangedExcept(['status', 'deliveredAt', 'deliveredByUid', 'deliveredByName', 'deliveredToName', 'deliveredToApartment']))
      );
    }

    // -------------------------------------------------------------------
    // found_items — objetos encontrados/perdidos. Al entregarlo, el guardia
    // debe indicar nombre y apartamento de quien lo retira (deliveredToName/
    // deliveredToApartment) — es la bitácora que pidió administración para
    // poder investigar una entrega equivocada.
    // -------------------------------------------------------------------
    match /found_items/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      // Ago-2026 v2: admin puede borrar cualquier objeto encontrado — ver
      // nota igual en parking_sessions más arriba.
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'delivered' &&
         request.resource.data.deliveredByUid == request.auth.uid &&
         unchangedExcept(['status', 'deliveredAt', 'deliveredByUid', 'deliveredByName', 'deliveredToName', 'deliveredToApartment']))
      );
    }

    // -------------------------------------------------------------------
    // objects — catálogo administrado por admin; availableQuantity la
    // ajusta el guardia como efecto de un préstamo/devolución (+-1).
    // Cada objeto tiene un campo `lobby` ('A' o 'B'): pertenece al
    // inventario de ese lobby únicamente (ago-2026, para poder prestar
    // objetos sin conexión sin arriesgar sobre-préstamos entre lobbies
    // distintos — ver nota en objects.service.js).
    // -------------------------------------------------------------------
    match /objects/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard');
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // A diferencia de las demás colecciones, aquí SÍ se permite borrar
      // cualquier objeto (no solo los de demostración): es una capacidad
      // general de administración del catálogo, pedida explícitamente para
      // poder quitar objetos de la lista, no solo desactivarlos. Los
      // préstamos ya hechos (object_loans) conservan el nombre del objeto
      // guardado en el propio préstamo, así que el historial sigue siendo
      // legible aunque el objeto ya no exista.
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // El guardia solo puede ajustar availableQuantity (efecto de un
      // préstamo/devolución) de un objeto de SU PROPIO lobby (ago-2026: cada
      // objeto pertenece a un solo lobby, ver nota arriba en "Crear
      // objeto"). Un administrador puede ajustar cualquiera.
      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' &&
         resource.data.lobby == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lobby &&
         unchangedExcept(['availableQuantity']) &&
         (request.resource.data.availableQuantity == resource.data.availableQuantity - 1 ||
          request.resource.data.availableQuantity == resource.data.availableQuantity + 1))
      );
    }

    // -------------------------------------------------------------------
    // object_loans
    // -------------------------------------------------------------------
    match /object_loans/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      // Ago-2026 v2: admin puede borrar cualquier préstamo — ver nota igual
      // en parking_sessions más arriba.
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Crear un préstamo (guardia): solo de un objeto que pertenezca a SU
      // PROPIO lobby — así se hace cumplir del lado del servidor lo mismo
      // que fetchActiveObjects(profile.lobby) ya oculta en la interfaz.
      // Devolver (más abajo) queda sin esta restricción a propósito: un
      // residente puede devolver un objeto en cualquier lobby, aunque
      // pertenezca al inventario del otro.
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' &&
          get(/databases/$(database)/documents/objects/$(request.resource.data.objectId)).data.lobby ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lobby)) &&
        request.resource.data.loanedByUid == request.auth.uid &&
        request.resource.data.status == 'loaned';

      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
         resource.data.status == 'loaned' &&
         request.resource.data.status == 'returned' &&
         request.resource.data.returnedByUid == request.auth.uid &&
         unchangedExcept(['status', 'returnedAt', 'returnedByUid', 'returnedByName', 'returnObservations', 'returnCondition']))
      );
    }

    // -------------------------------------------------------------------
    // access_items — tarjetas / stickers. El guardia SOLO marca "entregado".
    // -------------------------------------------------------------------
    match /access_items/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Ago-2026 v2: admin puede borrar cualquier tarjeta/sticker — ver nota
      // igual en parking_sessions más arriba.
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow update: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'delivered' &&
         request.resource.data.deliveredByUid == request.auth.uid &&
         unchangedExcept(['status', 'deliveredAt', 'deliveredByUid', 'deliveredByName', 'deliveredLobby']))
      );
    }

    // -------------------------------------------------------------------
    // offices — directorio de teléfonos de oficinas/comercios (ago-2026),
    // para que el guardia vea el teléfono al escribir el código en el campo
    // "Torre + piso + unidad" de Parqueos/Visitantes/Paquetes/Tarjetas (ver
    // destination-field.js). El ID del documento ES el código canónico
    // ("B-203"). Solo lectura para el guardia — administración es quien
    // carga y mantiene la lista.
    // -------------------------------------------------------------------
    match /offices/{code} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      allow write: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------
    // audit_logs — nadie puede EDITAR un registro (integridad de cada
    // entrada). Ago-2026 v2: a pedido explícito de administración, un admin
    // sí puede BORRAR registros en bloque (por ejemplo desde
    // Administración → Desarrollador → "Reiniciar datos del sistema") —
    // antes esto era "if false" sin ninguna excepción.
    // -------------------------------------------------------------------
    match /audit_logs/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'viewer');
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
        request.resource.data.userUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------
    // error_reports — el guardia reporta y solo ve sus propios reportes;
    // solo administración puede resolverlos.
    // -------------------------------------------------------------------
    match /error_reports/{id} {
      allow read: if isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
         resource.data.reportedByUid == request.auth.uid)
      );
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard') &&
        request.resource.data.reportedByUid == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Ago-2026 v2: admin puede borrar reportes de error — antes era
      // "if false" sin excepción.
      allow delete: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------
    // public_status — espejo MÍNIMO y sin datos personales de una visita de
    // parqueo, pensado para que el propio visitante consulte cuánto tiempo
    // le queda escaneando un código QR, SIN iniciar sesión. A propósito es
    // una colección separada de parking_sessions: esta nunca tiene nombre,
    // cédula ni placa — solo hora de entrada, límite de tiempo y estado.
    // "get" (leer un documento puntual, si ya se sabe su ID) es público;
    // "list" (listar/buscar todos) sigue bloqueado siempre, así que nadie
    // puede navegar ni descubrir visitas de otras personas sin su código.
    // -------------------------------------------------------------------
    match /public_status/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard');
    }

    // Cualquier otra ruta no contemplada queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
